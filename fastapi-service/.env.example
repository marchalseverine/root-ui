# Shared secret with the Next.js app (must match root-ui .env.local INTERNAL_API_SECRET)
INTERNAL_API_SECRET=your-internal-api-secret

# Anthropic API key. If unset, the service streams a deterministic mock response.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Model used for generation (Claude). Defaults to claude-sonnet-4-6.
LLM_MODEL=claude-sonnet-4-6
