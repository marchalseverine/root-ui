# --- Supabase ---
# Project URL and keys from the Supabase dashboard (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Internal service auth ---
# Shared secret between Next.js and the FastAPI generation service.
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=your-internal-api-secret

# --- FastAPI generation service ---
# Base URL the Next.js server uses to reach the FastAPI service (server-side only)
FASTAPI_BASE_URL=http://localhost:8000

# --- Public demo ---
# ID of the project served on the public /demo route (must have is_demo = true)
NEXT_PUBLIC_DEMO_PROJECT_ID=your-demo-project-id
